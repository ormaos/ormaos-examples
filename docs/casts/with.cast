[17.939028, "o", "\r\n"]
[24.374471, "o", "Found it: 5 orders were skipped by a swallowed `SkuFormatError`. Next I'm checking which orders they were and what \r\ntheir SKUs looked like.\r\n\r\n"]
[25.471044, "o", "\u001b[36m\u001b[1m> Bash\u001b[0m .venv/bin/ormaos tree r1:c106 --offset 28 --depth 2 | grep -B1 -A1 raised; for e in 2 3 4 5; do .venv/bin/ormaos\r\n    exceptions r1:e$e | head -2; done; ls -a; ls .ormaos\r\n"]
[25.752374, "o", "\u001b[2m      r1:c198 to_units(quantity: int, unit: str[4], pack_size: int) -> int  inventory.py:71  9us\u001b[0m\r\n\u001b[2m    r1:c199 check_order(order: parse.Order) -> raised  validate.py:47  987us  calls below: 1\u001b[0m\r\n\u001b[2m      r1:c200 check_sku(sku: str[9]) -> raised  validate.py:22  27us\u001b[0m\r\n\u001b[2m    r1:c201 check_order(order: parse.Order) -> NoneType  validate.py:47  45us  calls below: 3\u001b[0m\r\n\u001b[2m  --\u001b[0m\r\n\u001b[2m      r1:c212 to_units(quantity: int, unit: str[4], pack_size: int) -> int  inventory.py:71  9us\u001b[0m\r\n"]
[25.752426, "o", "\u001b[2m    r1:c213 check_order(order: parse.Order) -> raised  validate.py:47  44us  calls below: 1\u001b[0m\r\n\u001b[2m      r1:c214 check_sku(sku: str[8]) -> raised  validate.py:22  26us\u001b[0m\r\n\u001b[2m    r1:c215 check_order(order: parse.Order) -> NoneType  validate.py:47  42us  calls below: 3\u001b[0m\r\n\u001b[2m  ... 8 of the 47 calls directly below r1:c106 are not shown (4 apply_order, 4 check_order; 1 raised): --offset 39\u001b[0m\r\n"]
