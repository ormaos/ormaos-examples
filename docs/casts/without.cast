[7.131745, "o", "\u001b[36m\u001b[1m> Bash\u001b[0m for f in README.md job.py fetch.py parse.py validate.py inventory.py data/*.csv data/cron.log;\r\n    do echo \"=== $f\"; cat -n $f; done\r\n"]
[7.187647, "o", "\u001b[2m  === README.md\u001b[0m\r\n\u001b[2m       1  # order-sync\u001b[0m\r\n\u001b[2m       2  \u001b[0m\r\n\u001b[2m       3  A scheduled job that takes the new orders from the sales system and applies them to the \u001b[0m\r\n\u001b[2m  warehouse inventory: for every order, the ordered quantity leaves the stock of that SKU.\u001b[0m\r\n\u001b[2m       4  \u001b[0m\r\n\u001b[2m       5  It uses only the Python standard library (Python 3.12 or newer). The folder is self-\u001b[0m\r\n\u001b[2m  contained: copy it anywhere and it runs.\u001b[0m\r\n"]
[7.187766, "o", "\u001b[2m       6  \u001b[0m\r\n\u001b[2m       7  ## Run it\u001b[0m\r\n\u001b[2m       8  \u001b[0m\r\n\u001b[2m       9  ```bash\u001b[0m\r\n\u001b[2m  ... 571 more lines\u001b[0m\r\n\r\n"]
[13.163715, "o", "\u001b[36m\u001b[1m> Bash\u001b[0m cat -A data/orders.csv && echo && python3 -I - <<'EOF'\r\n    import sqlite3\r\n    c=sqlite3.connect(\"file:data/inventory.db?mode=ro\",uri=True)\r\n    for t in (\"stock\",\"applied_orders\",\"backorders\"):\r\n        print(\"==\",t)\r\n        for r in c.execute(f\"select * from {t}\"): print(r)\r\n    EOF\r\n    python3 inventory.py --db data/inventory.db --count data/count.csv\r\n"]
[13.248101, "o", "\u001b[2m  order_id,placed_at,sku,quantity,channel,unit^M$\u001b[0m\r\n\u001b[2m  SO-20538,2026-11-25T21:30,CAB-0302,4,marketplace,each^M$\u001b[0m\r\n\u001b[2m  SO-20539,2026-11-26T06:10,MSE-0102,2,web,each^M$\u001b[0m\r\n\u001b[2m  SO-20540,2026-11-26T06:48,KBD-0101,3,marketplace,each^M$\u001b[0m\r\n\u001b[2m  SO-20541,2026-11-26T07:15,CAB-0302,1,store,pack^M$\u001b[0m\r\n\u001b[2m  SO-20542,2026-11-26T07:40,HDS-0402,2,marketplace,each^M$\u001b[0m\r\n\u001b[2m  SO-20543,2026-11-26T08:05,WEB-0401,1,web,each^M$\u001b[0m\r\n"]
[13.248127, "o", "\u001b[2m  SO-20544,2026-11-26T08:31,MON-0201,1,marketplace,each^M$\u001b[0m\r\n\u001b[2m  SO-20545,2026-11-26T08:55,HUB-0301,2,store,each^M$\u001b[0m\r\n\u001b[2m  SO-20546,2026-11-26T09:12,KBD-0101,1,web,each^M$\u001b[0m\r\n\u001b[2m  \u001b[0m\r\n\u001b[2m  == stock\u001b[0m\r\n\u001b[2m  ... 54 more lines\u001b[0m\r\n"]
