# The base image of every agent: Ubuntu, the Python of the tasks, uv, and
# what the canary needs (curl). Nothing of any agent.
#
# The base and uv are pinned by digest. The Ubuntu packages are not pinned:
# every result records the id of the image that was built.
FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

FROM ubuntu:26.04@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 python3-venv ca-certificates curl git \
 && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/
COPY canary.sh /usr/local/bin/harness-canary
RUN chmod 0755 /usr/local/bin/harness-canary
ENV LANG=C.UTF-8
